{
	"name": "roadtrip",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.11.0",
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint && pnpm lint:project",
		"lint:project": "fallow dead-code && fallow architecture && fallow dupes --fail-on-issues && fallow health --complexity && node lint/oxlint-overrides.ts && node lint/agents-pointers.ts",
		"health": "fallow health --hotspots --targets",
		"typecheck": "pnpm --recursive --if-present run typecheck",
		"test": "vitest run",
		"e2e": "pnpm --filter web e2e"
	},
	"devDependencies": {
		"@tanstack/eslint-plugin-query": "5.107.1",
		"@tanstack/eslint-plugin-router": "1.162.0",
		"eslint": "10.14.0",
		"eslint-plugin-playwright": "2.12.2",
		"fallow": "3.39.0",
		"oxfmt": "0.76.0",
		"oxlint": "1.91.0",
		"oxlint-tsgolint": "7.0.2005",
		"typescript": "^5.9.3",
		"vitest": "^5.1.0"
	}
}
