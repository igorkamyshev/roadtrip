{
	"name": "data",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "The dataset build: the road graph and the zone outlines from an OSM extract, the cities file from GeoNames and Wikidata with the table of Russian names, the places file from OSM and Wikidata, and the command that computes a ring from an extract.",
	"exports": {
		"./cities-file": "./src/cities-file.ts",
		"./fixture-graph": "./test/fixture-graph.ts",
		"./places-file": "./src/places-file.ts"
	},
	"scripts": {
		"build-cities": "node src/cli/build-cities.ts",
		"build-graph": "node src/cli/build-graph.ts",
		"build-places": "node src/cli/build-places.ts",
		"engine-fingerprint": "node src/cli/engine-fingerprint.ts",
		"exclude-places": "node src/cli/exclude-places.ts",
		"fetch-dataset": "node src/cli/fetch-dataset.ts",
		"publish-dataset": "node src/cli/publish-dataset.ts",
		"region": "node src/cli/region.ts",
		"render": "node src/cli/render.ts",
		"ring": "node src/cli/ring.ts",
		"russian-names": "node src/cli/russian-names.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"valhalla": "node --max-old-space-size=10240 src/cli/valhalla.ts"
	},
	"dependencies": {
		"engine": "workspace:*",
		"fast-xml-parser": "^5.12.0",
		"pbf": "^5.1.2",
		"polygon-clipping": "^0.15.7",
		"rules": "workspace:*"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/node": "^22.20.5",
		"typescript": "^5.9.3",
		"vitest": "^5.1.0"
	}
}
