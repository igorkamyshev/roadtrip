#!/bin/sh
# Installed by `pnpm install` (the root "prepare" script sets core.hooksPath),
# and in cloud sessions by .claude/hooks/session-start.sh.
set -e
node scripts/agents-symlinks.ts --stage

# Fix, then format the staged files, and stage the result: formatting goes last
# because Oxlint's and Stylelint's fixes are not formatted. Symlinks are skipped:
# oxfmt would format the file a CLAUDE.md symlink points at, which is staged on
# its own.
files=$(git diff --cached --name-only --diff-filter=ACMR | while read -r f; do [ -L "$f" ] || echo "$f"; done)
if [ -n "$files" ]; then
	code=$(echo "$files" | grep -E '\.(ts|tsx|js|mjs|cjs)$' || true)
	if [ -n "$code" ]; then
		before=$(echo "$code" | xargs git hash-object)
		# Errors that --fix cannot fix stop the commit.
		echo "$code" | xargs pnpm exec oxlint --fix
		# Some of Oxlint's fixes break types (ADR 0002): once one changed a file, the whole
		# repository's types are checked, since a package's change can break its consumers.
		if [ "$before" != "$(echo "$code" | xargs git hash-object)" ]; then
			out=$(pnpm typecheck 2>&1) || {
				echo "$out"
				echo "Oxlint's fixes broke the types above: fix them, or undo the fix and disable the rule on its line with the reason."
				exit 1
			}
		fi
	fi
	# Stylelint fixes what it can in the stylesheets; what it cannot stops the commit.
	css=$(echo "$files" | grep -E '\.css$' || true)
	if [ -n "$css" ]; then
		echo "$css" | xargs pnpm exec stylelint --fix --allow-empty-input
	fi
	echo "$files" | xargs pnpm exec oxfmt --no-error-on-unmatched-pattern
	echo "$files" | xargs git add
fi

# The project as a whole: dead code, architecture, duplication, cognitive complexity, the
# overrides' files, the pointers to the packages' AGENTS.md (lint/agents-pointers.ts) and the screen tests'
# names, each helper in one place (lint/e2e-names.ts).
# Its report shows only when it fails: a clean run is twenty lines of banners.
out=$(pnpm --silent lint:project 2>&1) || {
	echo "$out"
	exit 1
}
