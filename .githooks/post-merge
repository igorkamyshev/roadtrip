#!/bin/sh
# Installed with the pre-commit hook (the root "prepare" script sets core.hooksPath).
# After a merge or a pull that changed the lockfile, brings node_modules in line with it,
# so the next typecheck does not fail on a package the merge added.
if git diff --name-only ORIG_HEAD HEAD -- pnpm-lock.yaml | grep -q .; then
	pnpm install --frozen-lockfile
fi
