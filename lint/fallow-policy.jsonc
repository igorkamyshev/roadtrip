{
	"$schema": "../node_modules/fallow/rule-pack-schema.json",
	"version": 1,
	"name": "roadtrip",
	"description": "Architecture rules the boundary zones cannot express (ADR 0002).",
	"rules": [
		{
			"id": "packages-by-name",
			"kind": "banned-import",
			// A path that climbs out of a package into another: two to four levels up, as deep as the packages go.
			"specifiers": [
				"../../data",
				"../../../data",
				"../../../../data",
				"../../engine",
				"../../../engine",
				"../../../../engine",
				"../../error-tracking",
				"../../../error-tracking",
				"../../../../error-tracking",
				"../../lint",
				"../../../lint",
				"../../../../lint",
				"../../rules",
				"../../../rules",
				"../../../../rules",
				"../../scripts",
				"../../../scripts",
				"../../../../scripts",
				"../../web",
				"../../../web",
				"../../../../web",
				"../../worker",
				"../../../worker",
				"../../../../worker",
			],
			"message": "Import another package by its name, through what its package.json exports (`engine/graph`, `worker/api`): a path into it bypasses them.",
		},
		{
			"id": "engine-portable",
			"kind": "banned-import",
			// Node's built-in modules (`builtinModules` of Node 22), with and without `node:`.
			"specifiers": [
				"node:assert",
				"assert",
				"node:async_hooks",
				"async_hooks",
				"node:buffer",
				"buffer",
				"node:child_process",
				"child_process",
				"node:cluster",
				"cluster",
				"node:console",
				"console",
				"node:constants",
				"constants",
				"node:crypto",
				"crypto",
				"node:dgram",
				"dgram",
				"node:diagnostics_channel",
				"diagnostics_channel",
				"node:dns",
				"dns",
				"node:domain",
				"domain",
				"node:events",
				"events",
				"node:fs",
				"fs",
				"node:http",
				"http",
				"node:http2",
				"http2",
				"node:https",
				"https",
				"node:inspector",
				"inspector",
				"node:module",
				"module",
				"node:net",
				"net",
				"node:os",
				"os",
				"node:path",
				"path",
				"node:perf_hooks",
				"perf_hooks",
				"node:process",
				"process",
				"node:punycode",
				"punycode",
				"node:querystring",
				"querystring",
				"node:readline",
				"readline",
				"node:repl",
				"repl",
				"node:stream",
				"stream",
				"node:string_decoder",
				"string_decoder",
				"node:sys",
				"sys",
				"node:timers",
				"timers",
				"node:tls",
				"tls",
				"node:trace_events",
				"trace_events",
				"node:tty",
				"tty",
				"node:url",
				"url",
				"node:util",
				"util",
				"node:v8",
				"v8",
				"node:vm",
				"vm",
				"node:wasi",
				"wasi",
				"node:worker_threads",
				"worker_threads",
				"node:zlib",
				"zlib",
			],
			"files": ["engine/src/**", "rules/src/**"],
			"message": "The engine runs in a Container today and may move to a Worker or a browser: no Node API in engine/src, nor in the rules it reads (engine/AGENTS.md, Portable).",
		},
	],
}
