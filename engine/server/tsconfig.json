{
	// The engine server of the Container: Node, run as TypeScript by Node 22's type stripping
	// (`node server/main.ts`), so only erasable syntax and `.ts` import specifiers. The engine itself in src/
	// stays without Node types (../tsconfig.json).
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"strict": true,
		"noImplicitReturns": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"allowImportingTsExtensions": true,
		"types": ["node"]
	},
	"include": ["**/*.ts", "../src/**/*.ts"]
}
