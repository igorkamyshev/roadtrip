{
	// The engine runs in a Container under Node today and may move to a Worker or a browser (ADR 0001), so it
	// sees no Node or DOM types: a Node API in src/ fails the typecheck. The data package runs it under
	// Node's type stripping, so only erasable syntax and `.ts` import specifiers.
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"allowImportingTsExtensions": true,
		"types": []
	},
	"include": ["src/**/*.ts"]
}
