{
	// The screen tests (Playwright) and the build configs with the bundle budget's plugin: Node, plus the DOM for code that runs in the page.
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2024", "dom"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"strict": true,
		"noImplicitReturns": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": [
		"./**/*.ts",
		"../vite.config.ts",
		"../playwright.config.ts",
		"../bundle-budget.ts",
		"../bundle-budget.test.ts",
		"../older-browsers.ts"
	]
}
