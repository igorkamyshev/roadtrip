{
	"name": "web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "The client: the one screen of the site, built into the static assets of the Worker roadtrip.",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"demo": "vite build && node e2e/demo-cli.ts",
		"record": "vite build && node e2e/record.ts",
		"shots": "vite build && node e2e/shots.ts",
		"icons": "node e2e/icons.ts",
		"e2e": "playwright test",
		"typecheck": "tsc --noEmit && tsc --noEmit -p e2e"
	},
	"dependencies": {
		"@fontsource/golos-text": "^5.3.0",
		"@fontsource/unbounded": "^5.3.0",
		"@protomaps/basemaps": "^5.7.2",
		"@tanstack/react-query": "^5.107.1",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-virtual": "^3.14.26",
		"data": "workspace:*",
		"maplibre-gl": "^6.16.0",
		"posthog-js": "^1.447.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rules": "workspace:*"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@posthog/rollup-plugin": "^1.6.3",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-legacy": "^8.2.4",
		"@vitejs/plugin-react": "^6.2.1",
		"typescript": "^5.9.3",
		"vite": "^8.3.6",
		"vitest": "^5.1.0",
		"worker": "workspace:*"
	},
	"browserslist": [
		"chrome >= 93",
		"edge >= 93",
		"firefox >= 92",
		"safari >= 15.4",
		"ios_saf >= 15.4"
	]
}
