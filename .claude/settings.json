{
	"hooks": {
		"SessionStart": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" }] }],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|Bash",
				"hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && node lint/claude-hook.ts" }]
			}
		],
		"Stop": [{ "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && node lint/claude-hook.ts" }] }],
		"SubagentStop": [{ "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && node lint/claude-hook.ts" }] }]
	},
	"worktree": { "baseRef": "head" }
}
