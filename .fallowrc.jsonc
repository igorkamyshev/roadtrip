{
	// Dead code, duplication, architecture and cognitive complexity (ADR 0002).
	// Every rule is an error or off: fallow never warns here.
	"$schema": "./node_modules/fallow/schema.json",
	"minimumVersion": "3.39.0",

	// Generated by `wrangler types`.
	"ignorePatterns": ["**/worker-configuration.d.ts"],

	// Files started by path, which no package.json, config or wrangler config names.
	"entry": [
		"engine/server/compute-thread.ts", // the engine server's worker thread (engine/server/calculator.ts)
		"lint/plugin.ts", // `jsPlugins` of .oxlintrc.json
		"lint/claude-hook.ts", // the Claude Code hook in .claude/settings.json
		"scripts/agents-symlinks.ts", // the pre-commit hook and CI
		"web/e2e/failures.ts", // a reporter that web/playwright.config.ts names by its path
	],

	// Every rule fallow would only warn about is an error here; the ones for frameworks this repo
	// does not use (Vue, Svelte, Angular, Next, Effect, CSS) are listed too, so nothing ever warns.
	"rules": {
		"unused-dev-dependencies": "error",
		"unused-optional-dependencies": "error",
		"type-only-dependencies": "error",
		"test-only-dependencies": "error",
		"dev-dependencies-in-production": "error",
		"unused-dependency-overrides": "error",
		"unused-catalog-entries": "error",
		"empty-catalog-groups": "error",
		"re-export-cycle": "error",
		"package-cycle": "error",
		"duplicate-exports": "error",
		"stale-suppressions": "error",
		"require-suppression-reason": "error",
		"boundary-violation": "error",
		"policy-violation": "error",
		"weakened-tests": "error",
		"added-suppression": "error",
		"test-only-branch": "error",
		"unused-store-members": "error",
		"unprovided-injects": "error",
		"unrendered-components": "error",
		"unused-component-props": "error",
		"unused-component-emits": "error",
		"unused-component-inputs": "error",
		"unused-component-outputs": "error",
		"unused-svelte-events": "error",
		"unused-effect-layers": "error",
		"unused-tagged-errors": "error",
		"unproduced-catch-tags": "error",
		"unused-server-actions": "error",
		"unused-load-data-keys": "error",
		"invalid-client-export": "error",
		"mixed-client-server-barrel": "error",
		"misplaced-directive": "error",
		"css-token-drift": "error",
		"css-duplicate-block": "error",
		"css-selector-complexity": "error",
		"css-dead-surface": "error",
		"css-broken-reference": "error",
		// Oxlint owns cyclomatic complexity and file length; CRAP without coverage data is a guess.
		"complexity-cyclomatic": "off",
		"complexity-file-lines": "off",
		"complexity-crap": "off",
		"complexity-cognitive": "error",
	},

	// Who may import whom: the packages by their package.json dependencies, and within a package its sources never
	// import its tests. The first zone a file matches is its zone; a file may always import its own zone. A package
	// imports another by name, through its package.json exports (lint/fallow-policy.jsonc, packages-by-name).
	"boundaries": {
		"zones": [
			{ "name": "et-logger", "patterns": ["error-tracking/src/logger.ts"] },
			{ "name": "et", "patterns": ["error-tracking/**"] },
			{ "name": "rules", "patterns": ["rules/**"] },
			{ "name": "engine-server", "patterns": ["engine/server/**"] },
			{ "name": "engine", "patterns": ["engine/**"] },
			{ "name": "data-test", "patterns": ["data/test/**"] },
			{ "name": "data", "patterns": ["data/**"] },
			{ "name": "worker-test", "patterns": ["worker/src/**/*.test.ts", "worker/test/**"] },
			{ "name": "worker", "patterns": ["worker/**"] },
			{ "name": "web-e2e", "patterns": ["web/e2e/**"] },
			{ "name": "web-tools", "patterns": ["web/tools/**"] },
			{
				"name": "web-config",
				"patterns": [
					"web/vite.config.ts",
					"web/playwright.config.ts",
					"web/bundle-budget.ts",
					"web/bundle-budget.test.ts",
					"web/older-browsers.ts",
				],
			},
			{ "name": "web", "patterns": ["web/**"] },
			{ "name": "lint", "patterns": ["lint/**"] },
			{ "name": "scripts", "patterns": ["scripts/**"] },
			{ "name": "root", "patterns": ["vitest.config.ts", "stylelint.config.mjs"] },
		],
		"rules": [
			{ "from": "et-logger", "allow": [] },
			{ "from": "et", "allow": ["et-logger"] },
			{ "from": "rules", "allow": [] },
			// The engine is portable (engine/AGENTS.md): it never reaches the Node-only server.
			{ "from": "engine", "allow": ["rules"] },
			{ "from": "engine-server", "allow": ["engine", "rules"] },
			{ "from": "data", "allow": ["engine", "rules"] },
			{ "from": "data-test", "allow": ["data", "engine", "rules"] },
			// The Worker reaches error-tracking only through its logger.
			{ "from": "worker", "allow": ["engine", "et-logger", "rules"] },
			// The ring API's tests run the engine server in-process on graphs data's builder makes (data/fixture-graph).
			{ "from": "worker-test", "allow": ["worker", "engine", "engine-server", "et-logger", "rules", "data-test"] },
			// The screen reads the engine's types through the ring API's (worker/api), never its code.
			{ "from": "web", "allow": ["data", "rules", "worker"], "allowTypeOnly": ["engine"] },
			{ "from": "web-e2e", "allow": ["web", "data", "rules", "worker"], "allowTypeOnly": ["engine"] },
			// The tools that drive the built client (web/README.md, «Demo», «Mark»): the demo serves the screen tests' doubles.
			{ "from": "web-tools", "allow": ["web-e2e", "web", "data", "rules", "worker"], "allowTypeOnly": ["engine"] },
			{ "from": "web-config", "allow": ["web-e2e"] },
			{ "from": "lint", "allow": [] },
			{ "from": "scripts", "allow": [] },
			{ "from": "root", "allow": [] },
		],
		"coverage": { "requireAllFiles": true },
	},

	"rulePacks": ["lint/fallow-policy.jsonc"],

	// Outside tests, a block repeated in two places fails. *.test.* is skipped by default.
	"duplicates": {
		"mode": "mild",
		"minTokens": 35,
		"minLines": 5,
		"ignore": ["data/test/**", "worker/test/**", "web/e2e/**"],
	},

	"health": {
		"maxCognitive": 15,
		"ignore": ["**/*.test.ts", "data/test/**", "worker/test/**", "web/e2e/**"],
	},
}
